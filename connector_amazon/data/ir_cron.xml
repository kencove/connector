<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Hourly cron job for stock synchronization -->
    <record id="ir_cron_push_amz_stock" model="ir.cron">
        <field name="name">Amazon: Push Stock Updates</field>
        <field name="model_id" ref="model_amz_shop" />
        <field name="state">code</field>
        <field name="code">model.cron_push_stock()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>

    <!-- Hourly cron job for order synchronization -->
    <record id="ir_cron_sync_amz_orders" model="ir.cron">
        <field name="name">Amazon: Sync Orders</field>
        <field name="model_id" ref="model_amz_shop" />
        <field name="state">code</field>
        <field name="code">model.cron_sync_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>

    <!-- Hourly cron job for pushing shipment tracking -->
    <record id="ir_cron_push_amz_shipments" model="ir.cron">
        <field name="name">Amazon: Push Shipments</field>
        <field name="model_id" ref="model_amz_shop" />
        <field name="state">code</field>
        <field name="code">model.cron_push_shipments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>

    <!-- Daily cron job for syncing competitive pricing -->
    <record id="ir_cron_sync_amz_competitive_prices" model="ir.cron">
        <field name="name">Amazon: Sync Competitive Pricing</field>
        <field name="model_id" ref="model_amz_shop" />
        <field name="state">code</field>
        <field name="code">model.cron_sync_competitive_prices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>

    <!-- Daily cron job for bulk catalog sync via Reports API -->
    <record id="ir_cron_sync_amz_catalog_bulk" model="ir.cron">
        <field name="name">Amazon: Bulk Catalog Sync (Reports)</field>
        <field name="model_id" ref="model_amz_shop" />
        <field name="state">code</field>
        <field name="code">model.cron_sync_catalog_bulk()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
    </record>
</odoo>
